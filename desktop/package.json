{
  "name": "bas-simulator",
  "productName": "Северный дрон",
  "version": "1.0.0",
  "description": "Северный дрон — тренажёр операторов беспилотных систем: миссии в Республике Коми",
  "main": "main.cjs",
  "author": "Борисова Анастасия Александровна",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "ru.basarena.simulator",
    "productName": "Северный дрон",
    "artifactName": "Severny-Dron-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "app/**/*",
      "build/icon.png"
    ],
    "asar": true,
    "asarUnpack": [
      "app/**/*.hdr",
      "app/**/*.glb"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "legalTrademarks": "Северный дрон"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Северный дрон",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1049",
      "artifactName": "Severny-Dron-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Severny-Dron-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "publish": null,
    "copyright": "© 2026 БАС Арена",
    "afterPack": "build/afterPack.cjs"
  }
}
