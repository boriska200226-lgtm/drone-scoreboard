# Сборка SPA
FROM oven/bun:1 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
ARG VITE_GUILD_API=/api
ARG VITE_GUILD_WS=/ws
ENV VITE_GUILD_API=$VITE_GUILD_API VITE_GUILD_WS=$VITE_GUILD_WS
RUN bun run build

# Раздача статики + проксирование REST/WS на guild-api
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
