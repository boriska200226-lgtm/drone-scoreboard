# Пароль к базе — придумай свой
POSTGRES_PASSWORD=change-me-please

# Ключ шифрования Реестра «кличка → имя».
# Сгенерировать:
#   docker run --rm python:3.11-slim sh -c "pip -q install cryptography && \
#     python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Потеряешь ключ — Реестр не расшифруется никогда. Храни отдельно от бэкапа базы.
REGISTRY_KEY=

# Разовый секрет для создания первого класса (заголовок X-Bootstrap-Token).
# После первого запуска смени или очисти.
BOOTSTRAP_TOKEN=

# Второй фактор Хранителя. Выключать только на время наладки.
REQUIRE_TEACHER_2FA=true

# Час ночного пересчёта Брони и часовой пояс школы
ARMOR_JOB_HOUR=22
TZ_NAME=Europe/Moscow

# Порт, на котором поднимется сайт
WEB_PORT=8080
